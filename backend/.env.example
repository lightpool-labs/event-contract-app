DEV_SECRET_KEY=
# Bridge LP USDT (from event-contract-setup 00_bridge_bootstrap / init-bridge).
CASH_TOKEN_ADDRESS=
CASH_TOKEN_SYMBOL=USDT
# EVM bridge (Reth local).
ETH_USDT=
BRIDGE=
EVM_RPC_URL=http://127.0.0.1:8545
EVM_CHAIN_ID=1337
# Session / agent key wrapping (dev defaults are fine locally).
JWT_SECRET=dev-jwt-secret-change-me
AGENT_ENCRYPTION_KEY=dev-agent-encryption-key
