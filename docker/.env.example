# Browser-facing URLs (NEXT_PUBLIC_* baked into frontend at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api
NEXT_PUBLIC_EVM_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_EVM_CHAIN_ID=1337
# SSR inside the frontend container (compose sets this; not for the browser)
# INTERNAL_API_URL=http://backend:3001/api

# Docker build proxy (apt during --no-cache). Build uses network: host.
HTTP_PROXY=http://127.0.0.1:8118
HTTPS_PROXY=http://127.0.0.1:8118
NO_PROXY=localhost,127.0.0.1

# Backend -> host services (node / clob-index / reth on the host)
CLOB_INDEX_URL=http://host.docker.internal:3002
EVM_RPC_URL=http://host.docker.internal:8545
EVM_CHAIN_ID=1337

JWT_SECRET=dev-jwt-secret-change-me
AGENT_ENCRYPTION_KEY=dev-agent-encryption-key
DEV_SECRET_KEY=
CASH_TOKEN_ADDRESS=
CASH_TOKEN_SYMBOL=USDT
ETH_USDT=
BRIDGE=
